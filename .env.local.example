# Sanity Studio (admin panel at /admin) — see sanity.config.ts / sanity.cli.ts
# Get these after running `npx sanity login` and creating a project (npx sanity init)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Google Search Console — see lib/seo.ts. Add the property at
# search.google.com/search-console, choose "HTML tag" verification, and
# paste just the content value here (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
